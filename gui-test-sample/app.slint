import { Button, LineEdit, VerticalBox } from "std-widgets.slint";

component Card inherits Rectangle {
    in property <string> title;
    in-out property <bool> selected;
    property <int> click-count;
    background: selected ? #ddf : #fff;
    height: 30px;
    Text { text: root.title; }
    TouchArea {
        clicked => {
            root.selected = !root.selected;
            root.click-count += 1;
        }
    }
}

export component App inherits Window {
    in-out property <int> counter: 0;
    out property <string> status: counter > 3 ? "many" : "few";
    in property <[string]> names: ["a", "b", "c"];
    property <bool> unused-flag;
    callback submitted(string);

    VerticalBox {
        label := Text { text: "Count: \{root.counter}"; }
        ok-button := Button {
            text: "Increment";
            clicked => { root.counter += 1; }
        }
        input := LineEdit {
            placeholder-text: "Name";
            accepted(t) => { root.submitted(t); }
        }
        for name[i] in root.names : Card { title: name; }
    }
}
